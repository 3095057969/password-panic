{
  "name": "password-panic",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "A tiny browser game about increasingly unreasonable password rules.",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/rules.test.mjs tests/state.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e.test.mjs",
    "test:all": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "playwright-core": "1.64.1"
  },
  "engines": {
    "node": ">=20"
  }
}
